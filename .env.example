# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit real keys.

APP_ENV=dev

# Primary LLM generator — free key at https://console.groq.com
GROQ_API_KEY=

# Optional fallback — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq is OpenAI-compatible. Verified 2026-08-26: openai/gpt-oss-20b works well for
# RAG. Groq renames models often — check GET https://api.groq.com/openai/v1/models.
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Local embedding model (downloads once, then runs offline & free).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where Chroma persists its index on disk.
CHROMA_DIR=.chroma
