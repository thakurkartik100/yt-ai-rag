# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit real keys.

APP_ENV=dev

# Primary LLM generator — free key at https://console.groq.com
GROQ_API_KEY=

# Optional fallback — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Exact current model id from the Groq console (they rename models often).
LLM_MODEL=llama-3.3-70b-versatile

# Local embedding model (downloads once, then runs offline & free).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where Chroma persists its index on disk.
CHROMA_DIR=.chroma
